# ============================================================================
#  PIVOT SWITCH
# ============================================================================
# Provider for bot-initiated messages (/admin/send). Inbound messages are
# always answered on the channel they arrived on, so both can run at once.
WA_PROVIDER=twilio            # twilio | meta

# Public HTTPS base URL of this service (ngrok/Vercel/DO), no trailing slash.
# Required for Twilio signature validation behind a tunnel.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# ============================================================================
#  AGENT
# ============================================================================
AGENT_MODE=claude             # claude | echo  (echo = no LLM, free plumbing test;
                              #                 send "fail" to simulate an error)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5
FLOWS_ENABLED=true            # welcome menu + AI-maturity quiz + talk KB (false = plain agent)

# ============================================================================
#  TWILIO  (enabled when SID + token are set)
# ============================================================================
# console.twilio.com > Account info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# Sandbox number by default; replace with your own Twilio WhatsApp sender later
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_VALIDATE_SIGNATURE=true

# ============================================================================
#  META CLOUD API  (enabled when token + phone number id are set)
# ============================================================================
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_API_VERSION=v20.0
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
# App Dashboard > App settings > Basic > App secret (enables signature checks)
META_APP_SECRET=

# ============================================================================
#  HUMAN ESCALATION / ALERTS
# ============================================================================
# Where humans pick up: slack | flex   (flex applies to Twilio-channel users;
# Meta users and any Flex failure fall back to Slack)
HANDOFF_TARGET=slack
FLEX_WORKSPACE_SID=WSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # TaskRouter > Workspaces > "Flex Task Assignment"
FLEX_WORKFLOW_SID=WWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx    # its workflow, e.g. "Assign to Anyone"
FLEX_TASK_CHANNEL=chat
FLEX_CONVERSATION_CLOSE_TIMER=PT24H                     # auto-close safety net

# Slack Incoming Webhook (api.slack.com/apps > Incoming Webhooks)
SLACK_WEBHOOK_URL=
# --- Slack app: one thread per WhatsApp conversation (README "Slack threads")
# Leave SLACK_BOT_TOKEN empty to keep the webhook-only behavior above.
SLACK_BOT_TOKEN=                # xoxb-...  OAuth & Permissions > Bot User OAuth Token
SLACK_SIGNING_SECRET=           # Basic Information > App Credentials > Signing Secret
SLACK_CHANNEL_ID=               # C0...  channel > About (bottom); /invite @app there
SLACK_ALERT_USER_ID=            # U0...  your member ID, @mentioned on escalations
SLACK_THREAD_IDLE_HOURS=24      # new thread after this long without customer messages
SLACK_STATE_FILE=.slack_threads.json  # keeps thread links across restarts ("" = memory only)

# --- Conversation lifecycle -------------------------------------------------
SESSIONS_FILE=data/sessions.json  # session registry; survives restarts ("" = memory only)
IDLE_WARN_MINUTES=10              # "are you still there?" after this long without activity
IDLE_CLOSE_MINUTES=5              # ...close this long after the warning (0 = never)
RESTART_NOTICE=true               # apologize to recent users when a restart wiped their chat
# Close right away when the user signals they're done ("sería todo, gracias", "that's all"):
# wider whole-message keyword list + the agent's end_conversation tool for the rest.
# false = only the classic goodbye words (adiós, bye, ...); idle timeout closes everything else.
CLOSE_ON_INTENT=true

# --- Off-topic guard (cheap classifier before the main agent) ---------------
GUARD_ENABLED=true
GUARD_MODEL=claude-haiku-4-5
OFFTOPIC_MAX_WARNINGS=2           # the next off-topic message escalates to Alan

# Random string; send as X-Admin-Token to /admin/* endpoints
ADMIN_TOKEN=

# Comma-separated E.164 numbers (no "+") allowed to talk to the bot. Empty = anyone.
ALLOWED_SENDERS=
