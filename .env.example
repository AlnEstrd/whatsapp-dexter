# ============================================================================
#  PIVOT SWITCH
# ============================================================================
# Provider for bot-initiated messages (/admin/send). Inbound messages are
# always answered on the channel they arrived on, so both can run at once.
WA_PROVIDER=twilio            # twilio | meta

# Public HTTPS base URL of this service (ngrok/Vercel/DO), no trailing slash.
# Required for Twilio signature validation behind a tunnel.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# ============================================================================
#  AGENT
# ============================================================================
AGENT_MODE=claude             # claude | echo  (echo = no LLM, free plumbing test;
                              #                 send "fail" to simulate an error)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5
FLOWS_ENABLED=true            # welcome menu + AI-maturity quiz + talk KB (false = plain agent)

# ============================================================================
#  TWILIO  (enabled when SID + token are set)
# ============================================================================
# console.twilio.com > Account info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# Sandbox number by default; replace with your own Twilio WhatsApp sender later
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_VALIDATE_SIGNATURE=true

# ============================================================================
#  META CLOUD API  (enabled when token + phone number id are set)
# ============================================================================
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_API_VERSION=v20.0
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
# App Dashboard > App settings > Basic > App secret (enables signature checks)
META_APP_SECRET=

# ============================================================================
#  HUMAN ESCALATION / ALERTS
# ============================================================================
# Where humans pick up: slack | flex   (flex applies to Twilio-channel users;
# Meta users and any Flex failure fall back to Slack)
HANDOFF_TARGET=slack
FLEX_WORKSPACE_SID=WSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # TaskRouter > Workspaces > "Flex Task Assignment"
FLEX_WORKFLOW_SID=WWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx    # its workflow, e.g. "Assign to Anyone"
FLEX_TASK_CHANNEL=chat
FLEX_CONVERSATION_CLOSE_TIMER=PT24H                     # auto-close safety net

# Slack Incoming Webhook (api.slack.com/apps > Incoming Webhooks)
SLACK_WEBHOOK_URL=
# --- Slack app: one thread per WhatsApp conversation (README "Slack threads")
# Leave SLACK_BOT_TOKEN empty to keep the webhook-only behavior above.
SLACK_BOT_TOKEN=                # xoxb-...  OAuth & Permissions > Bot User OAuth Token
SLACK_SIGNING_SECRET=           # Basic Information > App Credentials > Signing Secret
SLACK_CHANNEL_ID=               # C0...  channel > About (bottom); /invite @app there
SLACK_ALERT_USER_ID=            # U0...  your member ID, @mentioned on escalations
SLACK_THREAD_IDLE_HOURS=24      # new thread after this long without customer messages
SLACK_STATE_FILE=.slack_threads.json  # old JSON thread map: imported into SQLite once, then renamed *.imported

# --- Conversation lifecycle -------------------------------------------------
SESSIONS_FILE=data/sessions.json  # old JSON session registry: imported into SQLite once, then renamed *.imported
IDLE_WARN_MINUTES=10              # "are you still there?" after this long without activity
IDLE_CLOSE_MINUTES=5              # ...close this long after the warning (0 = never)
RESTART_NOTICE=true               # apologize after a restart only if a chat's state could NOT be recovered
CLOSE_ON_INTENT=true              # "Sería todo, gracias" / "That's all" + the agent's end_conversation tool close
                                  # the chat (bare "gracias" never does); false = only adiós/bye/terminar...

# --- Persistence (SQLite, README "Persistence") ------------------------------
DB_PATH=data/bot.sqlite3          # conversations, history, quiz, sessions, Slack threads, dedupe, usage
                                  # ("" = memory only: everything is lost on restart)
HISTORY_MAX_MESSAGES=40           # agent history kept per user (oldest trimmed; tool pairs never split)
RETENTION_DAYS=30                 # purge closed/idle conversations (and usage rows) older than this
PROCESSED_RETENTION_DAYS=7        # keep webhook message ids (dedupe) this long

# --- Voice notes (README "Voice notes") --------------------------------------
# Claude doesn't take audio: notes are transcribed first by any OpenAI-compatible
# /audio/transcriptions endpoint. No key = voice notes get the "photos and PDFs only" reply.
VOICE_ENABLED=true
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=https://api.openai.com/v1   # Groq: https://api.groq.com/openai/v1
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe         # Groq: whisper-large-v3-turbo

# --- Usage and cost caps (README "Limits") -----------------------------------
LIMITS_ENABLED=true               # false = no caps, exactly the old behavior (usage is still recorded)
USER_MSG_PER_MINUTE=6             # inbound messages per user per rolling minute (quiz answers don't count)
USER_MSG_PER_DAY=120              # inbound messages per user per day (America/Mexico_City)
USER_FILES_PER_DAY=10             # inbound photos/PDFs/voice notes per user per day
USER_TOKENS_PER_DAY=300000        # input+output tokens per user per day, all model calls
DAILY_TOKEN_BUDGET=5000000        # all users: 80% -> one Slack alert (@SLACK_ALERT_USER_ID), 100% -> no model calls

# --- Off-topic guard (cheap classifier before the main agent) ---------------
GUARD_ENABLED=true
GUARD_MODEL=claude-haiku-4-5
OFFTOPIC_MAX_WARNINGS=2           # the next off-topic message escalates to Alan

# --- On-request information (app/kb/on_request/, only for people who explicitly ask) -
ON_REQUEST_ENABLED=true
ON_REQUEST_DIR=                   # empty = app/kb/on_request
ON_REQUEST_EXTRA_DIR=data/on_request   # optional entries on the volume (not in git); same id wins
META_VERIFICATION_STATUS=         # live-status fallback until a Meta verification webhook arrives, e.g. "en revisión"

# --- Metrics & governance (README "Metrics & governance") --------------------
ANALYTICS_ENABLED=true            # false = no events, question samples or llm_calls rows (everything else as before)
# QR prefill text -> entry source (JSON; matched ignoring case/accents/punctuation). Others = "organic".
ENTRY_SOURCES={"hola dexter": "qr_talk"}
# Price override in USD per million tokens (defaults in app/analytics/pricing.py: Sonnet 4.5, Haiku 4.5)
MODEL_PRICES_JSON=
# Optional: Anthropic Admin API key (sk-ant-admin...) to reconcile our cost with Anthropic's usage/cost
# reports. Read-only use, server-side only; leave empty to turn the feature off.
ANTHROPIC_ADMIN_KEY=
METRICS_DIGEST_ENABLED=true       # daily Slack summary (needs SLACK_BOT_TOKEN)
METRICS_DIGEST_HOUR=8             # America/Mexico_City
SLACK_METRICS_CHANNEL_ID=         # C0... e.g. #dexter-metrics (invite the app); empty = SLACK_CHANNEL_ID

# --- Read-only MCP connector for claude.ai (README "MCP connector") -----------
MCP_ENABLED=false                 # refuses to start unless the password has 16+ chars and the secret is set
MCP_PUBLIC_URL=https://origin.alanestrada.space   # https origin, no path; the server lives at /mcp
MCP_OAUTH_CLIENT_ID=              # any random id, e.g. `python -c "import secrets;print(secrets.token_urlsafe(16))"`
MCP_OAUTH_CLIENT_SECRET=          # random, e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`
MCP_OWNER_PASSWORD=               # 16+ characters; asked once when you connect claude.ai
MCP_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback   # comma-separated allowlist

# --- One-tap CSAT: 👍/👎 buttons inside the farewell after a user close (Meta only)
CSAT_ENABLED=false

# Random string; send as X-Admin-Token to /admin/* endpoints
ADMIN_TOKEN=

# Comma-separated E.164 numbers (no "+") allowed to talk to the bot. Empty = anyone.
ALLOWED_SENDERS=
