  {
    "id": "leads-buying-signal",
    "lang": "es",
    "env": {
      "LEADS_ENABLED": "true"
    },
    "message": "¿Alan nos puede ayudar a implementar IA en el área de ventas de mi empresa?",
    "mock": {
      "agent": [
        {
          "tool": "flag_buying_signal",
          "input": {
            "kind": "wants_help_implementing",
            "note": "IA en ventas"
          }
        },
        {
          "text": "Sí, ese es justo el tipo de proyecto que Alan acompaña."
        }
      ]
    },
    "expect": {
      "route": "agent",
      "tool_called": "flag_buying_signal",
      "must_not_contain": [
        "score",
        "puntaje"
      ],
      "state": {
        "consent_asked": true
      }
    }
  },
  {
    "id": "leads-cuanto-cobra",
    "lang": "es",
    "env": {
      "LEADS_ENABLED": "true"
    },
    "message": "¿cuánto cobra Alan por una consultoría?",
